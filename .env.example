# Copy this file to .env and replace the placeholders with your TiDB Cloud credentials.
TIDB_HOST=YOUR_TIDB_HOST
TIDB_PORT=4000
TIDB_DATABASE=medistock
TIDB_USER=YOUR_TIDB_USERNAME
TIDB_PASSWORD=YOUR_TIDB_PASSWORD
PORT=8080
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501
